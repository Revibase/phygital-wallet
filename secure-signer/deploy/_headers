# Cloudflare Pages / Netlify `_headers` for the signer origin.
# Copy into the published output root (dist/). Replace https://app.example.com
# with the real parent (app) origin before deploying.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://api.revibase.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.revibase.com
  Permissions-Policy: publickey-credentials-get=(self), clipboard-write=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-store

# Hashed, immutable build assets can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE:
# - connect-src allows only the owner-wallet backup API (restore + PUT). The
#   signer still never talks to Solana RPC; widen this list only with review.
# - clipboard-write=(self): export "Copy to clipboard" uses Clipboard API inside
#   this cross-origin iframe; the parent must also delegate clipboard-write via
#   Permissions-Policy + iframe allow=.
# - frame-ancestors (NOT X-Frame-Options: DENY): the signer is INTENDED to be
#   framed by the app origin. Do not add X-Frame-Options — it would break it.
# - Do NOT enable Cross-Origin-Embedder-Policy: require-corp. It forces the
#   embedder to be crossOriginIsolated and all subresources to be CORP/CORS,
#   which breaks the embedding model for no benefit here. COOP is a no-op on a
#   framed document.
# - index.html is no-store so a signer update is picked up immediately; only the
#   content-hashed /assets/* are cached.
