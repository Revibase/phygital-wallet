  "types": [
    {
      "name": "CompactInstruction",
      "docs": ["Index-based inner instruction for execute."],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "program_id_index",
            "docs": [
              "Index into `remaining_accounts` for the target program id."
            ],
            "type": "u8"
          },
          {
            "name": "account_indexes",
            "docs": [
              "Indexes into `remaining_accounts` for the instruction's accounts."
            ],
            "type": "bytes"
          },
          {
            "name": "data",
            "type": "bytes"
          }
        ]
      }
    },
    {
      "name": "Config",
      "docs": [
        "Global program config: admin + default verifier set (fee-payer/verifiers).",
        "",
        "Fixed-size so execute can `AccountLoader` (zero-copy) instead of",
        "Borsh-decoding a `Vec`."
      ],
      "serialization": "bytemuck",
      "repr": {
        "kind": "c"
      },
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "type": "pubkey"
          },
          {
            "name": "verifiers",
            "type": {
              "array": ["pubkey", 8]
            }
          },
          {
            "name": "verifier_count",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "_padding",
            "type": {
              "array": ["u8", 6]
            }
          }
        ]
      }
    },
    {
      "name": "RecoveryWallet",
      "docs": [
        "Optional ed25519 recovery key for a phygital token. When set, that key may",
        "call `recovery_wallet_execute` to drive the program wallet without the",
        "accessory passkey (lost-device recovery)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "phygital_token",
            "type": "pubkey"
          },
          {
            "name": "recovery_wallet",
            "docs": ["Ed25519 pubkey authorized to recover the wallet."],
            "type": "pubkey"
          },
          {
            "name": "payer",
            "docs": ["Account that paid init rent; close refunds this pubkey."],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Secp256r1VerifyArgs",
      "docs": [
        "Instruction-arg mirror of `phygital_token_client::Secp256r1VerifyArgs`.",
        "",
        "The crates.io client only derives Borsh for this type, which breaks Anchor's",
        "`idl-build` (`IdlBuild` methods). Keep a same-layout Anchor type here for the",
        "program interface and convert at the CPI boundary."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "verify_args_relative_index",
            "type": "i64"
          },
          {
            "name": "signed_message_index",
            "type": "u8"
          },
          {
            "name": "client_data_json",
            "type": "bytes"
          }
        ]
      }
    },
    {
      "name": "TokenVerifier",
      "docs": [
        "Optional per-phygital-token verifier override. When present, ONLY this",
        "verifier may authorize executes for that token (config set is not accepted).",
        "`endpoint` is the HTTPS URL of that verifier's build/sign/send service.",
        "",
        "Not on the execute hot path (read by offset in `resolve_verifier`); keep",
        "Borsh so the endpoint stays a human-readable `String` in the IDL."
