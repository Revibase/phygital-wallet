    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "phygital-token-sdk": "^1.0.3",
    "phygital-verifier-sdk": "workspace:*",
    "phygital-wallet-sdk": "workspace:*",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "phygital-policy": "workspace:*"
