{
  "name": "phygital-wallet-sdk",
  "version": "0.1.1",
  "description": "TypeScript client for the phygital-wallet Solana program",
  "license": "MIT",
  "author": "Revibase",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revibase/phygital-wallet.git",
    "directory": "packages/js/phygital-wallet"
  },
  "homepage": "https://github.com/Revibase/phygital-wallet/tree/main/packages/js/phygital-wallet",
  "bugs": {
    "url": "https://github.com/Revibase/phygital-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solana",
    "wallet",
    "phygital",
    "kit",
    "wallet-standard"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@solana/kit": "^8.1.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@solana-program/compute-budget": "^0.15.0",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@solana/wallet-standard-features": "^1.4.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/wallet": "^1.1.1",
    "phygital-token-sdk": "^1.0.3"
  },
  "devDependencies": {
    "@solana/kit": "^8.1.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
