{
  "name": "phygital-policy",
  "version": "0.1.0",
  "description": "Revibase payments/collectibles policy built on phygital-verifier-sdk + Codama clients from vendored IDLs",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "trim": "node scripts/trim-generated.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "phygital-verifier-sdk": "workspace:*",
    "@solana/instructions": "^8.1.0",
    "@solana/kit": "^8.1.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.3",
    "@codama/renderers-js": "^2.3.1",
    "@codama/visitors": "^1.3.3",
    "codama": "^1.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
