{
  "name": "phygital-verifier-sdk",
  "version": "0.2.0",
  "description": "Verify Solana instructions against composable Codama-backed policies",
  "license": "MIT",
  "author": "Revibase",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revibase/phygital-wallet.git",
    "directory": "packages/js/phygital-verifier"
  },
  "homepage": "https://github.com/Revibase/phygital-wallet/tree/main/packages/js/phygital-verifier",
  "bugs": {
    "url": "https://github.com/Revibase/phygital-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solana",
    "policy",
    "codama",
    "verifier",
    "phygital"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@solana/instructions": "^8.1.0",
    "@solana/kit": "^8.1.0",
    "phygital-token-sdk": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
