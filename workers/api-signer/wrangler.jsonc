{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revibase-verifier-signer",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // Private worker — only reachable via DO binding from revibase-api.
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_SIGNER",
        "class_name": "TokenSigner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-token-signer",
      "new_sqlite_classes": ["TokenSigner"]
    }
  ],
  "vars": {
    "SOLANA_CLUSTER": "mainnet",
    "SOLANA_RPC_URL": "https://rpc.revibase.com",
    "VERIFIER_SIGNER_BACKEND": "secrets",
    "TOP_UP_ACCUMULATOR": "BExDpnx6E1LW3ofkCPxXvBRAmxqPVsmwnPb4oM5FUutv",
    // debug | info | warn | error — override in .dev.vars for local verbosity
    "LOG_LEVEL": "info"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
