# Local secrets for `wrangler dev` (gitignored as `.dev.vars`).

# Structured Workers Logs verbosity (debug | info | warn | error)
LOG_LEVEL=debug

# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Token catalog (optional — without this, portfolio falls back to USDC-only)
# JUPITER_API_KEY=

# HttpOnly session cookie HMAC secret
# POLICY_SESSION_SECRET=dev-session-secret-change-me

# Fee balance paymaster (SOL top-up accumulator + Helius webhook auth)
# TOP_UP_ACCUMULATOR=
# HELIUS_WEBHOOK_AUTH=

# HMAC secret for POST /webhooks/transactions — must equal the
# helius-wallet-service WEBHOOK_SECRET. In prod set via `wrangler secret put`.
# WALLET_WEBHOOK_SECRET=

# JSON array of base58 pubkeys — must match the keys of api-signer VERIFIER_SECRET_KEYS
# DEFAULT_VERIFIER_PUBKEYS=["YourVerifierPubkeyBase58"]
