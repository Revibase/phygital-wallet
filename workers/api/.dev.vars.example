# Local secrets for `wrangler dev` (gitignored as `.dev.vars`).

# Structured Workers Logs verbosity (debug | info | warn | error)
LOG_LEVEL=debug

# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Token catalog (optional — without this, portfolio falls back to USDC-only)
# JUPITER_API_KEY=

# HttpOnly session cookie HMAC secret
# POLICY_SESSION_SECRET=dev-session-secret-change-me

# Fee balance (SOL top-up accumulator)
# TOP_UP_ACCUMULATOR=

# HMAC secret for POST /webhooks/transactions — must equal the
# helius-wallet-service WEBHOOK_SECRET. In prod set via `wrangler secret put`.
# Also drives fee credit/debit; service must watch TOP_UP_ACCUMULATOR and
# every DEFAULT_FEE_PAYER_PUBKEYS fee payer.
# WALLET_WEBHOOK_SECRET=

# JSON array of base58 pubkeys — must match the keys of api-signer FEE_PAYER_SECRET_KEYS
# DEFAULT_FEE_PAYER_PUBKEYS=["YourFeePayerPubkeyBase58"]

# Optional WebAuthn RP ID for owner-wallet blob fetch verification.
# Shared WebAuthn RP ID for blob-fetch assertion verify (must match app + signer).
# Default: derived from Origin (localhost → localhost, *.revibase.com → revibase.com).
# WEBAUTHN_RP_ID=localhost
