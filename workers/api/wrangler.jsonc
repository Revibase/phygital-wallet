{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revibase-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "phygital_token",
      "database_name": "phygital-token",
      "database_id": "356d6b15-cd60-47b5-a014-648246bd27b5",
      "migrations_dir": "d1/migrations"
    }
  ],
  "vars": {
    "SOLANA_CLUSTER": "mainnet",
    "SOLANA_RPC_URL": "https://rpc.revibase.com",
    "TOP_UP_ACCUMULATOR": "BExDpnx6E1LW3ofkCPxXvBRAmxqPVsmwnPb4oM5FUutv"
  },
  "kv_namespaces": [
    {
      "binding": "revibase_counter",
      "id": "a9aa768ab4854f11ac0314170849c172"
    }
  ],
  "services": [
    {
      "binding": "VERIFIER_SIGNER",
      "service": "revibase-verifier-signer",
      "entrypoint": "VerifierSignerEntrypoint"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
