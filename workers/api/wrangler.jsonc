{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revibase-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.revibase.com/tokens/*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/wallet/*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/verify-tap*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/sign*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/preview*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/policies/*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/auth*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/webhooks/*",
      "zone_name": "revibase.com"
    },
    {
      "pattern": "api.revibase.com/health",
      "zone_name": "revibase.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "phygital_token",
      "database_name": "phygital-token",
      "database_id": "356d6b15-cd60-47b5-a014-648246bd27b5",
      "migrations_dir": "d1/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "revibase_counter",
      "id": "a9aa768ab4854f11ac0314170849c172"
    }
  ],
  "services": [
    {
      "binding": "VERIFIER_SIGNER",
      "service": "revibase-verifier-signer",
      "entrypoint": "VerifierSignerEntrypoint"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
