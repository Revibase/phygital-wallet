# HTTP listen port (default 8787)
PORT=8787

# Ed25519 verifier secret: 32-byte seed or 64-byte keypair as base58, or JSON byte array.
# Generate with: pnpm generate-keypair
VERIFIER_SECRET_KEY=

# Optional: pin the expected base58 pubkey (derived from VERIFIER_SECRET_KEY if omitted)
# VERIFIER_PUBLIC_KEY=

# Standing policy caps (optional)
# MAX_SOL_LAMPORTS=100000000
# MAX_USDC_RAW=50000000
